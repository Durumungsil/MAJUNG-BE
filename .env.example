# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 깃에 올리지 않는다.
# 실제 값은 팀 비공개 채널로 받는다.

# Supabase Postgres
DB_URL=jdbc:postgresql://<host>:<port>/postgres
DB_USERNAME=
DB_PASSWORD=

# JWT 서명 키 (32바이트 이상 무작위 문자열)
JWT_SECRET=

# 구글 OAuth 클라이언트 ID (웹/안드로이드/iOS 여러 개면 콤마로 구분)
GOOGLE_CLIENT_IDS=

# Gemini (비워 두면 AI 타임라인 대신 규칙 기반으로 만든다)
GEMINI_API_KEY=

# Google Places API (New), 서버 전용 키
GOOGLE_PLACES_API_KEY=
# 유료 등급 확인 후에만 true. false이면 취향 프로필은 규칙 기반으로 완성한다.
GEMINI_PAID_TIER_CONFIRMED=false

# DB 스키마는 docs/migrations의 SQL 적용 후 검증한다.
# JPA_DDL_AUTO=validate

# 선택 ---------------------------------------------------------------
# 프론트 주소 (기본: localhost 3000, 5173, 8000, 8001, 8080)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 도커로 띄울 때 맥/PC 에서 접속할 포트 (기본 8080)
# API_PORT=8080
# DB 연결 풀 크기 (기본 3, Supabase 동시 연결 한도를 팀이 나눠 쓴다)
# DB_POOL_SIZE=3
# build.gradle 의 Java toolchain 버전 (기본 21)
# JAVA_VERSION=21
